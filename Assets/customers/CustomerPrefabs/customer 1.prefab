  anim: {fileID: 5504609489237736532}
  greetingLines:
  - " Finn: hm i see\u2026 this is the person stealing my customers\u2026 "
  - 'Coco: huh? what do you mean! '
  - " Finn: im joking haha! im Finn, the owner of the cafe across the street. you\u2019ve
    definitely heard of my delicious blueberry pies, right? "
  - "Finn: i heard your pastries were delicious so i came to see if it\u2019s worth
    the hype. "
  - "Finn: let\u2019s see, i wanna try a croissant! "
  thankYouLines:
  - "Finn: This is yummy\u2026 I wonder if my customers will come here instead\u2026 "
  badLines:
  - "Finn: This tastes a bit off\u2026 "
  - "Finn: but you can always come over to my bakery to try my recipes, they\u2019re
    perfection! "
  customerName: Finn
