  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33433a6c695994a5ab6c267bbf2fd664, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 107853842}
  lines:
  - Wow. Press on box to continue.
  - Welcome to Whisker!
  - This is a baking game where you play as a cat baker!
  - You can move with WASD and pick up with E key.
  - You can drop an apple and egg for a surprise pastry.
  - Give the pastry to the customer in front of you, the other animal.
  - The pastry behind you is what you get when you combine the two ingrediants.
  - Also, the pastry is what you give, not anything else.
  - 'Have fun! :-> '
  - Also, just press E to drop as well!
  textSpeed: 0.01
  autoCloseDelay: 3
